{
  "firewall": {
    "hostname": "PA-FW-PROD-01",
    "management_ip": "192.168.1.10",
    "vendor": "Palo Alto",
    "environment": "production"
  },
  "policies": [
    {
      "rule_id": 101,
      "name": "Allow-HTTPS",
      "source": "192.168.10.0/24",
      "destination": "10.10.10.0/24",
      "service": "HTTPS",
      "port": 443,
      "action": "allow",
      "enabled": true
    },
    {
      "rule_id": 102,
      "name": "Allow-SSH",
      "source": "192.168.20.0/24",
      "destination": "10.10.20.10/32",
      "service": "SSH",
      "port": 22,
      "action": "allow",
      "enabled": true
    },
    {
      "rule_id": 103,
      "name": "Block-Telnet",
      "source": "any",
      "destination": "any",
      "service": "TELNET",
      "port": 23,
      "action": "deny",
      "enabled": true
    }
  ]
}
