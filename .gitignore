# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform plans
*.tfplan
*.plan

# Local state backups
*state-backup*.json

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Cloud credentials and secrets
.aws/
*.pem
*.key
.env
.env.*
